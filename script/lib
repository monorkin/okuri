BINARY=okuri
REPO_URL=https://github.com/monorkin/$BINARY
VERSION=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)"/\1/')

# The hicolor sizes shipped in assets/icons, generated by script/icons from assets/icon.png.
#
# The PKGBUILDs carry their own copy of this list. They are standalone files that have to run
# on someone else's machine with only the tarball, so they cannot read this.
ICON_SIZES="48 64 128 256"
ICON_MASTER=assets/icon.png

die() {
  echo "$*" >&2
  exit 1
}
