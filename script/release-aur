#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
source script/lib

WORKDIR=target/aur
PKGREL=${PKGREL:-1}

main() {
  command -v makepkg >/dev/null || die "makepkg is required to publish to the AUR"

  # The source archive is generated by GitHub for any tag, released or not, so it says nothing
  # about whether 'make release-github' has run. The binary asset is what actually proves it,
  # and it is what publish_bin needs — better to fail here than halfway through a push.
  curl -fsIL "$REPO_URL/archive/v$VERSION.tar.gz" >/dev/null \
    || die "No tag v$VERSION on GitHub — push the tag first"
  curl -fsIL "$REPO_URL/releases/download/v$VERSION/$BINARY-linux-amd64" >/dev/null \
    || die "No binary attached to release v$VERSION, run 'make release-github' first"

  case ${1:-all} in
    src) publish_src ;;
    bin) publish_bin ;;
    all) publish_src && publish_bin ;;
    *) die "Usage: $0 [src|bin|all]" ;;
  esac
}

sha256_file() {
  sha256sum "$1" | cut -d' ' -f1
}

sha256_url() {
  curl -fsSL "$1" | sha256sum | cut -d' ' -f1
}

aur_clone() {
  rm -rf "$WORKDIR/$1"
  git clone "ssh://aur@aur.archlinux.org/$1.git" "$WORKDIR/$1"
  git -C "$WORKDIR/$1" checkout -B master
}

aur_push() {
  (cd "$WORKDIR/$1" && makepkg --printsrcinfo > .SRCINFO)
  git -C "$WORKDIR/$1" add -A
  git -C "$WORKDIR/$1" diff --cached --quiet || git -C "$WORKDIR/$1" commit -m "Update to v$VERSION"
  git -C "$WORKDIR/$1" push origin HEAD:master
}

publish_src() {
  echo
  echo "=== AUR: $BINARY ==="
  echo

  aur_clone "$BINARY"

  local tarball_sha
  tarball_sha=$(sha256_url "$REPO_URL/archive/v$VERSION.tar.gz")

  sed -e "s/@PKGVER@/$VERSION/" \
      -e "s/@PKGREL@/$PKGREL/" \
      -e "s/@TARBALL_SHA256@/$tarball_sha/" \
      packaging/aur/PKGBUILD > "$WORKDIR/$BINARY/PKGBUILD"

  aur_push "$BINARY"
}

publish_bin() {
  echo
  echo "=== AUR: $BINARY-bin ==="
  echo

  aur_clone "$BINARY-bin"

  local amd64_sha
  amd64_sha=$(sha256_url "$REPO_URL/releases/download/v$VERSION/$BINARY-linux-amd64")

  sed -e "s/@PKGVER@/$VERSION/" \
      -e "s/@PKGREL@/$PKGREL/" \
      -e "s/@AMD64_SHA256@/$amd64_sha/" \
      -e "s/@LICENSE_SHA256@/$(sha256_file LICENSE)/" \
      -e "s/@DESKTOP_SHA256@/$(sha256_file packaging/$BINARY.desktop)/" \
      -e "s/@ICON_48_SHA256@/$(sha256_file assets/icons/$BINARY-48.png)/" \
      -e "s/@ICON_64_SHA256@/$(sha256_file assets/icons/$BINARY-64.png)/" \
      -e "s/@ICON_128_SHA256@/$(sha256_file assets/icons/$BINARY-128.png)/" \
      -e "s/@ICON_256_SHA256@/$(sha256_file assets/icons/$BINARY-256.png)/" \
      packaging/aur/PKGBUILD-bin > "$WORKDIR/$BINARY-bin/PKGBUILD"
  cp LICENSE "packaging/$BINARY.desktop" "$WORKDIR/$BINARY-bin/"

  aur_push "$BINARY-bin"
}

main "$@"
